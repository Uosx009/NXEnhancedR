{
  "manifest_version": 3,
  "name": "NXEnhancedR",
  "version": "5.1.4",
  "homepage_url": "https://github.com/Uosx009/NXEnhancedR",
  "description": "Personal fixed build of NX Enhanced. Original by BLBC (hjk789). No new features, fixes only.",

  "icons": { "128": "icon.png" },

  "permissions": ["storage"],

  "host_permissions": [
  "https://my.nextdns.io/*",
  "https://api.nextdns.io/*",
  "https://*/*"
],

  "content_scripts":
  [{
      "matches": ["https://my.nextdns.io/*", "https://api.nextdns.io/*"],
      "js": ["utils.js", "NXEnhanced.js"]
  }],

  "options_ui": { "page": "options-page.html" },

  "action":
  {
    "default_title": "NX Enhanced",
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  }
}